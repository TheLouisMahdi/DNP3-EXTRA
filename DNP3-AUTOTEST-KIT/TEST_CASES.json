  "priority_scenarios": [
    {
      "id": "TCP-READ-01",
      "title": "Static inputs and precision",
      "category": "extend_ProcessSmoke",
      "steps": [
        "connected(auth=compat; fresh port; no unsolicited)",
        "out: set binary 0 on force",
        "out: set double 0 on force",
        "out: set analog 0 13.75 force",
        "master: read 1 2 0 0",
        "master: read 3 2 0 0",
        "master: read 30 5 0 0"
      ],
      "pass_oracles": [
        "Group1Var2 Binary[0]=ON",
        "Group3Var2 DoubleBit[0]=DETERMINED_ON",
        "Group30Var5 Analog[0]=13.75",
        "Each relevant TASK read SUCCESS"
      ],
      "fail_if": [
        "Stale value or task-only SUBMITTED"
      ],
      "constraints": [],
      "result": "NOT_RUN"
    },
    {
      "id": "TCP-EVENT-01",
      "title": "Solicited time-tagged precision event",
      "category": "extend_ProcessSmoke",
      "steps": [
        "connected(auth=compat; fresh port; no unsolicited)",
        "out: set analog 0 13.75 force",
        "master: read 32 7"
      ],
      "pass_oracles": [
        "Group32Var7 EVENT Analog[0]=13.75",
        "Valid time>0",
        "TASK read SUCCESS"
      ],
      "fail_if": [
        "Result from an old event or without a valid timestamp"
      ],
      "constraints": [],
      "result": "NOT_RUN"
    },
    {
      "id": "TCP-EVENT-INT-01",
