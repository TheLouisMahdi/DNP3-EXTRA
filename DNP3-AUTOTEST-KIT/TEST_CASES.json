      ],
      "constraints": [],
      "result": "NOT_RUN"
    },
    {
      "id": "TCP-CLASS-01",
      "title": "ASSIGN_CLASS and class3 event",
      "category": "extend_ProcessSmoke",
      "steps": [
        "connected(auth=compat; fresh port; no unsolicited)",
        "master: assign 30 3 0 0",
        "wait TASK assign SUCCESS",
        "out: set analog 0 14.25 force",
        "master: scan class3"
      ],
      "pass_oracles": [
        "TASK assign SUCCESS",
        "Group32Var7 EVENT Analog[0]=14.25",
        "TASK scan SUCCESS"
      ],
      "fail_if": [
        "Read of old event or class not genuinely reassigned"
      ],
      "constraints": [],
      "result": "NOT_RUN"
    },
    {
      "id": "TCP-UNSOL-01",
      "title": "Unsolicited receive with two-sided application CONFIRM",
      "category": "extend_ProcessSmoke",
      "steps": [
        "connected(auth=compat; outstation --unsolicited; --trace on both; fresh port)",
        "master: unsol on",
        "wait TASK unsol SUCCESS",
        "out: set binary 3 on force",
        "capture Master and Outstation traces"
      ],
      "pass_oracles": [
        "Master RX unsolicited G2V2 Binary[3]=ON",
        "Outstation TX UNSOLICITED_RESPONSE CON=1 SEQ=n",
        "Master TX CONFIRM UNS=1 SEQ=n",
        "Outstation RX CONFIRM UNS=1 SEQ=n"
      ],
      "fail_if": [
        "Missing Outstation receive confirmation",
        "Mismatched SEQ",
        "False duplicate detection from same value but distinct event timestamps"
      ],
      "constraints": [],
      "result": "NOT_RUN"
    },
    {
      "id": "TCP-UNSOL-02",
      "title": "Unsolicited disable and pending-event class poll",
      "category": "extend_ProcessSmoke",
      "steps": [
        "connected(auth=compat; outstation --unsolicited; fresh port)",
        "master: unsol on",
        "wait TASK unsol SUCCESS",
        "master: unsol off",
        "wait TASK unsol SUCCESS",
        "out: set binary 2 on force",
        "watch Master for a bounded 5 seconds (liveness required)",
        "master: scan class1"
      ],
      "pass_oracles": [
        "No UNSOLICITED_RESPONSE containing new Binary[2] during bounded interval",
        "Group2Var2 EVENT Binary[2]=ON after class1 poll",
        "TASK scan SUCCESS"
      ],
      "fail_if": [
        "Task submitted without completion",
        "Peer died during absence gate",
        "Old event confused with new one"
      ],
      "constraints": [],
      "result": "NOT_RUN"
